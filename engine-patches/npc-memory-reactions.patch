+bool
+CCivilianPed::UpdatePlayerMemory(void)
+{
+	if (!IsPedInControl() || DyingOrDead())
+		return false;
+
+	CPed *player = FindPlayerPed();
+	if (!player)
+		return false;
+
+	const uint32 now = CTimer::GetTimeInMilliseconds();
+	if (m_bRemembersPlayer && (int32)(now - m_nPlayerMemoryExpiry) >= 0) {
+		m_bRemembersPlayer = false;
+		m_bPlayerMemoryReacted = false;
+		m_nPlayerMemoryExpiry = 0;
+	}
+
+	// Build a memory only from a nearby event caused by the player.
+	// Ordinary proximity or simply seeing the player never creates a memory.
+	if (!m_bRemembersPlayer) {
+		for (int i = 0; i < NUMEVENTS; i++) {
+			const CEvent &event = gaEvent[i];
+			bool relevantEvent = event.type == EVENT_STEAL_CAR ||
+				 event.type == EVENT_HIT_AND_RUN ||
+				 event.type == EVENT_HIT_AND_RUN_COP;
+			if (!relevantEvent || event.criminal != player ||
+				(int32)(now - event.timeout) >= 0)
+				continue;
+
+			if ((GetPosition() - event.posn).MagnitudeSqr2D() > sq(18.0f) ||
+				(player->GetPosition() - event.posn).MagnitudeSqr2D() > sq(25.0f) ||
+				!CanSeeEntity(player))
+				continue;
+
+			CVector ourEye = GetPosition();
+			CVector playerEye = player->GetPosition();
+			ourEye.z += 1.0f;
+			playerEye.z += 1.0f;
+			if (!CWorld::GetIsLineOfSightClear(ourEye, playerEye,
+				true, true, false, false, false, false, false))
+				continue;
+
+			m_bRemembersPlayer = true;
+			m_bPlayerMemoryReacted = false;
+			m_nPlayerMemoryExpiry = now + 60000;
+			break;
+		}
+	}
+
+	if (!m_bRemembersPlayer || m_bPlayerMemoryReacted ||
+		(player->GetPosition() - GetPosition()).MagnitudeSqr2D() > sq(18.0f) ||
+		!CanSeeEntity(player))
+		return false;
+
+	CVector ourEye = GetPosition();
+	CVector playerEye = player->GetPosition();
+	ourEye.z += 1.0f;
+	playerEye.z += 1.0f;
+	if (!CWorld::GetIsLineOfSightClear(ourEye, playerEye,
+		true, true, false, false, false, false, false))
+		return false;
+
+	// Fearful pedestrians run away. More temperamental pedestrians keep their
+	// distance at a walk while watching the player; neither reaction changes physics.
+	if (m_pedStats && m_pedStats->m_fear > m_pedStats->m_temper) {
+		SetFindPathAndFlee(player, 8000);
+		SetMoveState(PEDMOVE_RUN);
+	} else {
+		SetFindPathAndFlee(player, 5000, true);
+		SetMoveState(PEDMOVE_WALK);
+		SetLookFlag(player, false);
+		SetLookTimer(1500);
+	}
+
+	m_bPlayerMemoryReacted = true;
+	return true;
+}
