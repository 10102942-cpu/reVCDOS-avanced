+
+static bool
+IsPlayerIncidentWorthRemembering(eEventType type)
+{
+	switch (type) {
+	case EVENT_ASSAULT:
+	case EVENT_ASSAULT_POLICE:
+	case EVENT_GUNSHOT:
+	case EVENT_STEAL_CAR:
+	case EVENT_HIT_AND_RUN:
+	case EVENT_HIT_AND_RUN_COP:
+	case EVENT_SHOOT_PED:
+	case EVENT_SHOOT_COP:
+	case EVENT_EXPLOSION:
+	case EVENT_PED_SET_ON_FIRE:
+	case EVENT_COP_SET_ON_FIRE:
+	case EVENT_CAR_SET_ON_FIRE:
+	case EVENT_ASSAULT_NASTYWEAPON:
+	case EVENT_ASSAULT_NASTYWEAPON_POLICE:
+		return true;
+	default:
+		return false;
+	}
+}
+
 void
+CCivilianPed::UpdatePlayerMemory(void)
+{
+	if (!IsPedInControl() || DyingOrDead())
+		return;
+
+	CPed *player = FindPlayerPed();
+	if (!player)
+		return;
+
+	const uint32 now = CTimer::GetTimeInMilliseconds();
+
+	// Each pedestrian keeps this memory only in the current game session.
+	if (m_bRemembersPlayer && (int32)(now - m_nPlayerMemoryExpiry) >= 0) {
+		m_bRemembersPlayer = false;
+		m_nPlayerMemoryExpiry = 0;
+		m_nNextPlayerMemoryReaction = 0;
+	}
+
+	if (m_bRemembersPlayer) {
+		if ((int32)(now - m_nNextPlayerMemoryReaction) < 0 || m_objective != OBJECTIVE_NONE)
+			return;
+
+		if ((player->GetPosition() - GetPosition()).MagnitudeSqr2D() > sq(18.0f) ||
+		    !CanSeeEntity(player))
+			return;
+
+		CVector ourEye = GetPosition();
+		CVector playerEye = player->GetPosition();
+		ourEye.z += 1.0f;
+		playerEye.z += 1.0f;
+		if (!CWorld::GetIsLineOfSightClear(ourEye, playerEye, true, true, false, false, false, false, false))
+			return;
+
+		// A high-temperament pedestrian may confront the player; others flee.
+		if (m_pedStats && m_pedStats->m_temper > m_pedStats->m_fear + 10) {
+			SetObjective(OBJECTIVE_KILL_CHAR_ON_FOOT, player);
+		} else {
+			SetFindPathAndFlee(player, 8000);
+			SetMoveState(PEDMOVE_RUN);
+		}
+		m_nNextPlayerMemoryReaction = now + 5000;
+		SetLookFlag(player, false);
+		SetLookTimer(500);
+		return;
+	}
+
+	// A memory is created only for a recorded player-caused incident that
+	// occurred nearby and was actually visible to this pedestrian.
+	for (int i = 0; i < NUMEVENTS; i++) {
+		const CEvent &event = gaEvent[i];
+		if (event.type == EVENT_NULL || event.criminal != player ||
+		    !IsPlayerIncidentWorthRemembering(event.type) ||
+		    (int32)(now - event.timeout) >= 0)
+			continue;
+
+		if ((GetPosition() - event.posn).MagnitudeSqr2D() > sq(20.0f) ||
+		    (player->GetPosition() - event.posn).MagnitudeSqr2D() > sq(28.0f) ||
+		    !CanSeeEntity(player))
+			continue;
+
+		CVector ourEye = GetPosition();
+		CVector playerEye = player->GetPosition();
+		ourEye.z += 1.0f;
+		playerEye.z += 1.0f;
+		if (!CWorld::GetIsLineOfSightClear(ourEye, playerEye, true, true, false, false, false, false, false))
+			continue;
+
+		m_bRemembersPlayer = true;
+		m_nPlayerMemoryExpiry = now + 60000;
+		m_nNextPlayerMemoryReaction = now;
+		break;
+	}
+}
